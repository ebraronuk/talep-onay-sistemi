# https://editorconfig.org
# Editor farkliliklarindan kaynaklanan "sadece bosluk degismis" commit'leri onler.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.java]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,json,css,html}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 4

[*.md]
# Markdown'da satir sonu iki bosluk anlamli
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
