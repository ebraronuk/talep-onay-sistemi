# docker compose bu degerleri okur. .env yoksa docker-compose.yml icindeki yerel
# gelistirme varsayilanlari kullanilir; gercek bir ortamda hepsini degistir.
#
# Not: DB_PASSWORD'u sonradan degistirirsen veritabani hacmini bastan olusturman
# gerekir. Hacim ilk acilistaki parolayla kurulur, yeni deger baglantiyi kirar.

DB_USERNAME=talep
DB_PASSWORD=talep

# En az 256 bit (32 bayt) olmali, aksi halde uygulama acilmaz.
# Uretmek icin: openssl rand -base64 48
JWT_SECRET=
